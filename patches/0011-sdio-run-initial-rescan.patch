+	/*
+	 * Allow the initial scan for SDIO as well as for the other card
+	 * types.  The vendor's aml_wifi driver powers the SDIO chip before
+	 * this host probes on the SC2 board, so suppressing the first
+	 * mmc_rescan leaves the card undiscovered.  If a board does not
+	 * power its card until userspace runs, the initial scan simply
+	 * finds nothing and sdio_reinit() can retry later.
+	 */
+	mmc->rescan_entered = 0;
 
