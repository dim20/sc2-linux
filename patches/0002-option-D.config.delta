# Option D: intentional config changes on top of meson64_a64_P_defconfig
#
# Applied with:
#   ./scripts/config --file out/.config --enable AMLOGIC_MEDIA_VIDEOCAPTURE
#   ./scripts/config --file out/.config --enable DRM_MESON_EMULATE_FBDEV
#   ./scripts/config --file out/.config --enable FRAMEBUFFER_CONSOLE
#   ./scripts/config --file out/.config --enable FRAMEBUFFER_CONSOLE_DETECT_PRIMARY
#   ./scripts/config --file out/.config --enable FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER
#
# ---------------------------------------------------------------------------
# CONFIG_AMLOGIC_MEDIA_VIDEOCAPTURE
#
# WHY: drivers/amlogic/media/video_sink/video_hw.c uses vd_layer[].capture_use_cnt,
# .capture_frame_req and CAPTURE_STATE_* unconditionally, but all three are inside
# #ifdef CONFIG_AMLOGIC_MEDIA_VIDEOCAPTURE in video_priv.h (lines 519, 628). The
# defconfig does not enable it, so the tree does not compile as shipped. Enabling
# the option is the correct fix (the .c is right; the defconfig is incomplete).
#
# Verified to survive syncconfig.
CONFIG_AMLOGIC_MEDIA_VIDEOCAPTURE=y
#
# ---------------------------------------------------------------------------
# CONFIG_DRM_MESON_EMULATE_FBDEV
#
# WHY: this is what makes the display usable.
#
# The vendor's DRM driver has a complete framebuffer emulation
# (drivers/amlogic/drm/meson_fbdev.c) which creates a /dev/fbN for the
# PRIMARY plane and one per OSD plane, using drm_fb_helper. It is all present
# and correct, but the whole thing sits behind this option:
#
#     drivers/amlogic/drm/meson_drv.c:355
#         #ifdef CONFIG_DRM_MESON_EMULATE_FBDEV
#                 ret = am_meson_drm_fbdev_init(drm);
#         #endif
#
# Without it there is no DRM framebuffer at all — only the four vendor OSD
# overlays, which have no fix_screeninfo.visual.weight and so are rejected
# by X's fbdev driver:
#
#     (EE) FBDEV(0): Weight given (000) is inconsistent with the depth (32)
#
# The DTB already provides everything it needs (fbdev_sizes,
# primary_plane_index, status=okay) and meson_drv.c already sets
# drm->irq_enabled = true for the vblank path. Nothing else is required.
CONFIG_DRM_MESON_EMULATE_FBDEV=y
#
# ---------------------------------------------------------------------------
# CONFIG_FRAMEBUFFER_CONSOLE and CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY
#
# WHY: so there is a text console on the HDMI output, not only on the
# serial port.
#
# This kernel has CONFIG_VT_CONSOLE=y but no framebuffer console, so
# /proc/consoles lists only ttyS0 and agetty on tty1 has a VT that nothing
# scans out to the display. Enabling fbcon binds a VT to the framebuffer.
#
# The option is named FRAMEBUFFER_CONSOLE, not FB_CONSOLE, and the
# implementation lives at drivers/video/fbdev/core/fbcon.c in this tree.
#
# DETECT_PRIMARY makes fbcon pick the PRIMARY display device, which is the
# one the HDMI transmitter actually scans out (the vendor OSD overlays are a
# different plane).
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
#
# ---------------------------------------------------------------------------
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER
#
# WHY: fbcon must not take the console over at the moment the framebuffers
# register.
#
# The vendor's DRM framebuffer is created during probe, before the HDMI
# pipeline is up, and taking the console over at that point programs a
# mode set the vendor's atomic-commit path cannot satisfy - it waits for
# a vblank that never arrives.
#
# With the option on, fbcon registers and waits, and the take-over
# happens later, when the display pipeline is live.
#
# WHY IT NEEDED A FIX (patches/0010)
#
# The take-over is deferred to a workqueue, and the workqueue is
# scheduled by a notifier that fires when the dummy console is written
# to. The dummy console is only the preferred one until a real console
# registers, so that notifier fires early - and if the work runs before
# the DRM's framebuffer has registered, it finds nothing to take over
# and nothing ever reschedules it. The console then never takes the
# display over, and /proc/consoles lists only the serial port.
#
# patches/0010 reschedules the work when a framebuffer registers, so it
# always runs after the framebuffer it is meant to take over.
#
# NOTE: on this architecture fb_is_primary_device() returns 0, so
# DETECT_PRIMARY on its own does nothing; the framebuffer console is bound
# to the right device because the vendor driver marks its primary-plane
# framebuffer FBINFO_PRIMARY - see patches/0003 and patches/0009.
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
#
# ---------------------------------------------------------------------------
# WiFi: mac80211 as a module, CCM built in
#
# WHY: the board's SDIO WiFi module is a Realtek RTL8822CS. The vendor
# 5.4 tree's in-tree rtw88 driver has no SDIO support, so the SDIO client
# driver is the lwfinger rtw88 backport, built out of tree against this
# kernel. It needs mac80211 and the CCMP cipher. The vendor defconfig
# leaves both off, so WPA2 association fails at key installation even
# when the driver itself probes correctly.
#
# mac80211 stays a module so the out-of-tree rtw88 modules can link
# against its exported symbols. CCM is now built in: CIFS selects
# CRYPTO_CCM, and a built-in cipher is still available to mac80211
# through the crypto API. The image ships the remaining modules in
# /lib/modules/<uname -r>/extra/; they are not in the kernel package,
# which remains Image-only by design.
CONFIG_MAC80211=m
CONFIG_CRYPTO_CCM=y
#
# ---------------------------------------------------------------------------
# Containers: Docker / containerd / runc
#
# WHY: the published kernel cannot create a container. Docker's own
# contrib/check-config.sh reports the following "Generally Necessary"
# checks missing, and runc fails before it can start anything:
#
#   IPC_NS            runc cannot create an IPC namespace
#   CGROUP_DEVICE     runc cannot enforce device access
#   BRIDGE            no docker0 / default bridge network
#   BRIDGE_NETFILTER  iptables rules on bridged traffic do not fire
#   CGROUP_PIDS       no pids cgroup
#   POSIX_MQUEUE      required by check-config
#
# IPC_NS is not free-standing: init/Kconfig makes it depend on
# (SYSVIPC || POSIX_MQUEUE), and both were off. That is why
# `unshare --ipc` returned EINVAL. SYSVIPC also restores System V IPC,
# which PostgreSQL and some Java software expect.
#
# The rest are the optional controllers and namespaces that make
# resource limits and `docker stats` behave as they do on Debian:
# PID/IO/CPU/memory/perf/hugetlb cgroups, user namespaces for rootless
# containers, and BINFMT_MISC for qemu-user (multi-arch builds).
#
# AppArmor and Yama match Debian's LSM set. AppArmor is compiled in but
# is not the primary LSM here: the vendor CONFIG_LSM lists SELinux
# first. Docker does not require AppArmor, so the order is left alone.
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_USER_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_BINFMT_MISC=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
#
# ---------------------------------------------------------------------------
# Container networking: bridge, overlay and nftables
#
# WHY: Docker cannot provide its default bridge network without BRIDGE,
# and BRIDGE_NETFILTER is what makes iptables see bridged packets.
# VXLAN/GENEVE/MACVLAN/IPVLAN are the drivers Docker uses for overlay
# and macvlan/ipvlan networks; BRIDGE_VLAN_FILTERING + VLAN_8021Q cover
# VLAN-aware bridges.
#
# NF_TABLES is what Debian 13's iptables userspace uses by default
# (iptables-nft) and is the native nftables API. NFT_COMPAT is the
# translation layer the iptables-nft front end needs. The NFT_* entries
# are the expressions a normal firewall uses. NF_TABLES_ARP is ARP
# filtering; IP_NF_ARP_MANGLE is its dependency.
#
# IP_VS and its protocol/scheduler modules are Docker Swarm's load
# balancer; IP_SCTP is the SCTP protocol some telephony containers
# bind; IP_SET is the ipset match/target used by common firewall
# tooling.
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_ARP=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FWD_NETDEV=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP_SET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_SCTP=y
#
# ---------------------------------------------------------------------------
# Filesystems and storage for expected tasks
#
# WHY: a general-purpose box needs to mount a NAS (NFS/CIFS, e.g. for
# Home Assistant backups) and to read the filesystems people put on
# external disks (btrfs, XFS, F2FS). BTRFS is also a Docker storage
# driver. DM_THIN_PROVISIONING covers devicemapper, NBD the network
# block device, and HUGETLBFS + CGROUP_HUGETLB the hugepage support
# some databases ask for. NETWORK_FILESYSTEMS is the parent menu for
# NFS and CIFS.
#
# Most of these are modules, not built in. They are large (btrfs and XFS
# alone are well over a megabyte of code) and none of them is needed to
# boot, to run Docker, or to bring up the network. Building them in pushed
# the Image past the 48 MiB BOOT partition's ~38.9 MiB budget. As modules
# they ship in the release rootfs under /lib/modules and load on demand;
# the kernel package itself stays Image-only. The bool sub-option and
# the menuconfig parent stay =y, which is legal for a tristate parent.
#
# F2FS stays built in. The vendor tree defines trace_android_fs_datawrite_wrap
# and trace_android_fs_dataread_wrap in fs/ext4/inode.c but does not
# EXPORT_SYMBOL them, so an f2fs.ko cannot resolve them and refuses to
# load ("unknown symbol"). Building f2fs in links it against the same
# built-in ext4 and works. The Image has the headroom for it.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_CIFS=m
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=y
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_BLK_DEV_NBD=m
CONFIG_HUGETLBFS=y
#
# ---------------------------------------------------------------------------
# USB serial devices
#
# WHY: Home Assistant's Zigbee and Z-Wave radios are USB serial
# adapters, and so are many dev boards. CP210x, CH341, FTDI and PL2303
# cover the common sticks; OPTION covers LTE modems and ACM the CDC-ACM
# class. These are small and built in so nothing has to be shipped as a
# module.
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_ACM=y
#
# ---------------------------------------------------------------------------
# Miscellaneous parity with Debian
#
# FANOTIFY is used by backup and file-indexing tools; CHECKPOINT_RESTORE
# enables CRIU and Docker's experimental checkpoint/restore.
CONFIG_FANOTIFY=y
CONFIG_CHECKPOINT_RESTORE=y
