-ifneq ("","$(wildcard /lib/modules/$(KVER)/kernel/drivers/net/wireless/realtek)")
-MODDESTDIR := /lib/modules/$(KVER)/kernel/drivers/net/wireless/realtek/rtw88
-else
-MODDESTDIR := /lib/modules/$(KVER)/kernel/drivers/net/wireless/rtw88
